'use client'

import { useState, useEffect, useRef } from 'react'
import { motion, AnimatePresence, useMotionValue, useSpring } from 'framer-motion'
import Image from 'next/image'
import { cn } from '@/lib/utils'
import { Flavor } from '@/lib/flavors'
import { useCart } from '@/lib/cart-context'
import confetti from 'canvas-confetti'

interface HeroProps {
  activeFlavor: Flavor
  onFlavorChange: (flavor: Flavor | ((prev: Flavor) => Flavor)) => void
  featuredFlavors: Flavor[]
}

export default function HeroPremium({ activeFlavor, onFlavorChange, featuredFlavors }: HeroProps) {
  const [isAutoPlaying, setIsAutoPlaying] = useState(true)
  const [touchStart, setTouchStart] = useState(0)
  const containerRef = useRef<HTMLDivElement>(null)
  const scrollContainerRef = useRef<HTMLDivElement>(null)
  const buttonRefs = useRef<{ [key: string]: HTMLButtonElement | null }>({})
  const scrollPositionRef = useRef(0)
  const isScrollingRef = useRef(false)
  const { addToCurrentBox, setIsOpen } = useCart()
  
  const mouseX = useMotionValue(0)
  const mouseY = useMotionValue(0)
  
  const springConfig = { stiffness: 75, damping: 25 }
  const donutX = useSpring(mouseX, springConfig)
  const donutY = useSpring(mouseY, springConfig)
  const prop1X = useSpring(mouseX, { stiffness: 50, damping: 30 })
  const prop1Y = useSpring(mouseY, { stiffness: 50, damping: 30 })
  const prop2X = useSpring(mouseX, { stiffness: 60, damping: 28 })
  const prop2Y = useSpring(mouseY, { stiffness: 60, damping: 28 })

  const navigateFlavor = (direction: 'next' | 'prev') => {
    const currentIndex = featuredFlavors.findIndex(f => f.id === activeFlavor.id)
    let nextIndex: number
    
    if (direction === 'next') {
      nextIndex = (currentIndex + 1) % featuredFlavors.length
    } else {
      nextIndex = (currentIndex - 1 + featuredFlavors.length) % featuredFlavors.length
    }
    
    onFlavorChange(featuredFlavors[nextIndex])
    setIsAutoPlaying(false)
  }

  useEffect(() => {
    if (!isAutoPlaying) {
      return
    }

    const interval = setInterval(() => {
      navigateFlavor('next')
    }, 6000)

    return () => {
      clearInterval(interval)
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [isAutoPlaying, activeFlavor])

  // Keyboard navigation
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        navigateFlavor('prev')
      } else if (e.key === 'ArrowRight') {
        navigateFlavor('next')
      }
    }

    window.addEventListener('keydown', handleKeyDown)
    return () => window.removeEventListener('keydown', handleKeyDown)
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [activeFlavor])
  
  // Infinite scroll logic
  useEffect(() => {
    const container = scrollContainerRef.current
    if (!container) return

    const handleScroll = () => {
      if (isScrollingRef.current) return
      
      const scrollLeft = container.scrollLeft
      const scrollWidth = container.scrollWidth
      const clientWidth = container.clientWidth
      
      // Calculate the width of the original items (without clones)
      const itemWidth = scrollWidth / (featuredFlavors.length * 3) // tripled for infinite scroll
      const originalWidth = itemWidth * featuredFlavors.length
      
      // If scrolled to the end (right side)
      if (scrollLeft + clientWidth >= scrollWidth - 10) {
        isScrollingRef.current = true
        container.scrollLeft = scrollLeft - originalWidth
        setTimeout(() => { isScrollingRef.current = false }, 50)
      }
      // If scrolled to the beginning (left side)
      else if (scrollLeft <= 10) {
        isScrollingRef.current = true
        container.scrollLeft = scrollLeft + originalWidth
        setTimeout(() => { isScrollingRef.current = false }, 50)
      }
      
      scrollPositionRef.current = container.scrollLeft
    }

    container.addEventListener('scroll', handleScroll)
    
    // Set initial scroll position to show original items (not clones)
    const itemWidth = container.scrollWidth / (featuredFlavors.length * 3)
    container.scrollLeft = itemWidth * featuredFlavors.length // Start at the middle set
    
    return () => {
      container.removeEventListener('scroll', handleScroll)
    }
  }, [featuredFlavors.length])
  
  // Auto-scroll to active flavor in strip
  useEffect(() => {
    const scrollToActive = () => {
      if (scrollContainerRef.current && buttonRefs.current[activeFlavor.id]) {
        const container = scrollContainerRef.current
        const activeButton = buttonRefs.current[activeFlavor.id]
        
        if (activeButton && !isScrollingRef.current) {
          // Get the first child div that contains the actual buttons
          const scrollWrapper = container.firstElementChild as HTMLElement
          
          // Calculate button position
          const buttonRect = activeButton.getBoundingClientRect()
          const containerRect = container.getBoundingClientRect()
          
          // Calculate current button position relative to container
          const buttonRelativeLeft = buttonRect.left - containerRect.left
          const containerCenter = containerRect.width / 2
          const buttonCenter = buttonRect.width / 2
          
          // Calculate how much we need to scroll
          const currentScroll = container.scrollLeft
          const targetScroll = currentScroll + buttonRelativeLeft - containerCenter + buttonCenter
          
          // Perform the scroll
          container.scrollTo({
            left: targetScroll,
            behavior: 'smooth'
          })
        }
      }
    }
    
    // Use requestAnimationFrame for smoother scrolling
    requestAnimationFrame(scrollToActive)
  }, [activeFlavor.id])

  const handleMouseMove = (e: React.MouseEvent) => {
    // Disable on touch devices and mobile screens
    if (window.matchMedia('(pointer: coarse)').matches) return
    if (window.innerWidth < 768) return
    // Check for reduced motion preference
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
    
    const rect = containerRef.current?.getBoundingClientRect()
    if (!rect) return
    
    // Reduced parallax for better control
    const x = ((e.clientX - rect.left) / rect.width - 0.5) * 3
    const y = ((e.clientY - rect.top) / rect.height - 0.5) * 3
    
    mouseX.set(x)
    mouseY.set(y)
  }

  const handleMouseLeave = () => {
    mouseX.set(0)
    mouseY.set(0)
  }

  const handleTouchStart = (e: React.TouchEvent) => {
    setTouchStart(e.touches[0].clientX)
    setIsAutoPlaying(false)
  }

  const handleTouchEnd = (e: React.TouchEvent) => {
    const touchEnd = e.changedTouches[0].clientX
    const diff = touchStart - touchEnd

    if (Math.abs(diff) > 60) {
      navigateFlavor(diff > 0 ? 'next' : 'prev')
    }
  }

  // Title animation variants
  const titleVariants = {
    hidden: { 
      opacity: 0,
      filter: 'blur(20px)',
    },
    visible: {
      opacity: 1,
      filter: 'blur(0px)',
      transition: {
        duration: 0.6,
        staggerChildren: 0.08,
      },
    },
    exit: {
      opacity: 0,
      filter: 'blur(20px)',
      transition: { duration: 0.3 },
    },
  }

  const letterVariants = {
    hidden: {
      opacity: 0,
      y: 50,
      rotateX: -90,
    },
    visible: {
      opacity: 1,
      y: 0,
      rotateX: 0,
      transition: {
        type: 'spring',
        damping: 12,
        stiffness: 200,
      },
    },
  }

  return (
    <section
      ref={containerRef}
      className="relative min-h-[100vh] min-h-[100dvh] w-full flex items-center justify-center overflow-hidden py-20 sm:py-24 lg:py-32"
      onMouseMove={handleMouseMove}
      onMouseLeave={handleMouseLeave}
      onTouchStart={handleTouchStart}
      onTouchEnd={handleTouchEnd}
    >
      {/* Dynamic themed gradient background */}
      <div className="absolute inset-0 overflow-hidden">
        {/* Main accent glow */}
        <div 
          className="absolute inset-0 opacity-[0.20]"
          style={{
            background: `radial-gradient(ellipse at center, var(--accent-light) 0%, transparent 60%)`,
          }}
        />
        {/* Top left glow - hidden on mobile */}
        <div 
          className="hidden sm:block absolute top-0 left-0 w-64 h-64 sm:w-96 sm:h-96 opacity-[0.25]"
          style={{
            background: `radial-gradient(circle, var(--accent) 0%, transparent 50%)`,
            filter: 'blur(40px)',
          }}
        />
        {/* Bottom right glow - hidden on mobile */}
        <div 
          className="hidden sm:block absolute bottom-0 right-0 w-64 h-64 sm:w-96 sm:h-96 opacity-[0.20]"
          style={{
            background: `radial-gradient(circle, var(--accent-light) 0%, transparent 50%)`,
            filter: 'blur(60px)',
          }}
        />
        <div 
          className="absolute inset-0"
          style={{
            background: `linear-gradient(180deg, rgba(255,255,255,0.7) 0%, rgba(255,255,255,0.85) 100%)`,
          }}
        />
        <div className="hero-shader opacity-60" />
      </div>

      {/* Floating orbs for depth - hidden on mobile */}
      <div className="hidden sm:block absolute inset-0 overflow-hidden pointer-events-none">
        {/* Large floating orb 1 */}
        <motion.div
          className="absolute w-96 h-96 rounded-full opacity-40"
          style={{
            background: `radial-gradient(circle, var(--accent-light) 0%, transparent 60%)`,
            left: '10%',
            top: '20%',
            filter: 'blur(20px)',
          }}
          animate={{
            x: [0, 30, 0],
            y: [0, -40, 0],
          }}
          transition={{
            duration: 20,
            repeat: Infinity,
            ease: 'easeInOut',
          }}
        />
        {/* Large floating orb 2 */}
        <motion.div
          className="absolute w-80 h-80 rounded-full opacity-35"
          style={{
            background: `radial-gradient(circle, var(--accent) 0%, transparent 60%)`,
            right: '15%',
            bottom: '25%',
            filter: 'blur(15px)',
          }}
          animate={{
            x: [0, -40, 0],
            y: [0, 30, 0],
          }}
          transition={{
            duration: 15,
            repeat: Infinity,
            ease: 'easeInOut',
          }}
        />
        {/* Medium floating orb 3 */}
        <motion.div
          className="absolute w-64 h-64 rounded-full opacity-30"
          style={{
            background: `radial-gradient(circle, var(--accent-dark) 0%, transparent 60%)`,
            left: '60%',
            top: '10%',
            filter: 'blur(25px)',
          }}
          animate={{
            x: [0, -20, 0],
            y: [0, 25, 0],
          }}
          transition={{
            duration: 18,
            repeat: Infinity,
            ease: 'easeInOut',
          }}
        />
        {/* Small floating orb 4 */}
        <motion.div
          className="absolute w-48 h-48 rounded-full opacity-45"
          style={{
            background: `radial-gradient(circle, var(--accent-light) 0%, transparent 50%)`,
            left: '35%',
            bottom: '15%',
            filter: 'blur(10px)',
          }}
          animate={{
            x: [0, 35, 0],
            y: [0, -20, 0],
          }}
          transition={{
            duration: 12,
            repeat: Infinity,
            ease: 'easeInOut',
          }}
        />
        {/* Tiny floating orb 5 */}
        <motion.div
          className="absolute w-32 h-32 rounded-full opacity-50"
          style={{
            background: `radial-gradient(circle, var(--accent) 0%, transparent 40%)`,
            right: '30%',
            top: '40%',
            filter: 'blur(8px)',
          }}
          animate={{
            x: [0, -15, 0],
            y: [0, -15, 0],
          }}
          transition={{
            duration: 10,
            repeat: Infinity,
            ease: 'easeInOut',
          }}
        />
      </div>

      <div className="relative z-10 w-full max-w-full px-4 sm:px-6 lg:px-8">
        <div className="w-full max-w-7xl mx-auto">
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-10 lg:gap-12 items-center">
          {/* Text Content */}
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.6 }}
            className="text-center lg:text-left order-2 lg:order-1"
          >
            {/* Animated Title */}
            <AnimatePresence mode="wait">
              <motion.h1
                key={activeFlavor.id}
                variants={titleVariants}
                initial="hidden"
                animate="visible"
                exit="exit"
                className="font-display font-black mb-4"
                style={{ 
                  fontSize: 'clamp(2rem, 5vw, 4rem)',
                  lineHeight: '1.15',
                  letterSpacing: '-0.02em',
                  color: 'transparent',
                  background: `linear-gradient(135deg, var(--accent) 0%, var(--accent-dark) 100%)`,
                  backgroundClip: 'text',
                  WebkitBackgroundClip: 'text',
                  textShadow: `0 2px 6px rgba(0,0,0,0.08)`,
                  wordBreak: 'keep-all',
                  overflowWrap: 'normal',
                  whiteSpace: 'normal'
                }}
              >
                {activeFlavor.name.replace(/ /g, '\u00A0')}
              </motion.h1>
            </AnimatePresence>

            <AnimatePresence mode="wait">
              <motion.p
                key={activeFlavor.id + '-description'}
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                exit={{ opacity: 0, y: -20 }}
                transition={{ duration: 0.4 }}
                className="text-base sm:text-lg lg:text-xl text-muted mb-6 sm:mb-8 leading-relaxed max-w-xl mx-auto lg:mx-0"
                style={{ wordBreak: 'keep-all' }}
              >
                {activeFlavor.description || 'Premium ingredients for an extraordinary taste experience'}
              </motion.p>
            </AnimatePresence>

            {/* Price */}
            <AnimatePresence mode="wait">
              <motion.div
                key={activeFlavor.id + '-price'}
                initial={{ opacity: 0, scale: 0.8 }}
                animate={{ opacity: 1, scale: 1 }}
                exit={{ opacity: 0, scale: 0.8 }}
                transition={{ type: 'spring', stiffness: 300, damping: 25 }}
                className="flex flex-col gap-1 mb-6 sm:mb-8 justify-center lg:justify-start items-center lg:items-start"
              >
                <div className="flex items-baseline gap-2">
                  <span className="text-2xl sm:text-4xl font-display font-bold" style={{ color: 'var(--accent)' }}>
                    {activeFlavor.priceOMR.toFixed(1)}
                  </span>
                  <span className="text-base sm:text-xl text-muted">OMR</span>
                </div>
                <span className="text-xs sm:text-sm text-muted/70 block mt-1">per 6 donuts</span>
              </motion.div>
            </AnimatePresence>

            {/* CTAs */}
            <div className="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <motion.button
                onClick={() => {
                  // Add 6 of the current flavor to a box
                  addToCurrentBox(activeFlavor, 6)
                  // Confetti celebration
                  confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 },
                    colors: [activeFlavor.accent, '#ffffff', activeFlavor.accent + '80'],
                  })
                  // Open cart drawer
                  setTimeout(() => setIsOpen(true), 500)
                }}
                className="px-8 py-3.5 rounded-full text-white font-semibold shadow-lg transition-all duration-300 text-base"
                style={{
                  background: `linear-gradient(135deg, var(--accent) 0%, var(--accent-dark) 100%)`,
                  boxShadow: `0 4px 15px var(--accent-light)`,
                }}
                whileHover={{ 
                  scale: 1.03,
                  boxShadow: '0 6px 20px var(--accent-light)'
                }}
                whileTap={{ scale: 0.98 }}
              >
                Add 6 to Box
              </motion.button>
              <motion.a
                href="#menu"
                className="px-8 py-3.5 rounded-full font-semibold text-ink btn-secondary no-tap-highlight text-base"
                whileHover={{ scale: 1.03 }}
                whileTap={{ scale: 0.98 }}
                onClick={(e) => {
                  e.preventDefault()
                  document.querySelector('#menu')?.scrollIntoView({ behavior: 'smooth' })
                }}
              >
                View Full Menu
              </motion.a>
            </div>

            {/* Flavor Selector */}
            <div className="mt-8 sm:mt-10 mb-8 sm:mb-12 lg:mb-16 w-full">
              <div 
                className="relative flex items-center"
                onTouchStart={(e) => e.stopPropagation()}
                onTouchEnd={(e) => e.stopPropagation()}
                onTouchMove={(e) => e.stopPropagation()}>
                {/* Navigation Arrows - Desktop Only */}
                <motion.button
                  onClick={() => navigateFlavor('prev')}
                  className="hidden lg:flex flex-shrink-0 mr-2 w-8 h-8 items-center justify-center rounded-full bg-white/90 backdrop-blur-sm shadow-md hover:shadow-lg transition-all"
                  aria-label="Previous flavor"
                  whileHover={{ scale: 1.1 }}
                  whileTap={{ scale: 0.9 }}
                >
                  <svg className="w-4 h-4 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2.5} d="M15 19l-7-7 7-7" />
                  </svg>
                </motion.button>
                
                <div ref={scrollContainerRef} className="flex gap-3 sm:gap-2 overflow-x-auto scrollbar-hide flex-1 pb-2 scroll-smooth">
                  <div className="flex gap-3 sm:gap-2 px-4 sm:px-2">
                {/* Triple the items for seamless infinite loop */}
                {[...featuredFlavors, ...featuredFlavors, ...featuredFlavors].map((flavor, index) => {
                  const isActive = flavor.id === activeFlavor.id
                  return (
                    <motion.button
                      key={`item-${index}-${flavor.id}`}
                      id={index === featuredFlavors.length ? `flavor-${flavor.id}` : undefined}
                      ref={index === featuredFlavors.length ? (el) => { if (el) buttonRefs.current[flavor.id] = el } : undefined}
                      onClick={() => {
                        onFlavorChange(flavor)
                        setIsAutoPlaying(false)
                      }}
                      className={cn(
                        "group relative flex flex-col items-center p-2 sm:p-1.5 rounded-xl transition-all duration-300 min-w-[80px] sm:min-w-[68px] flex-shrink-0",
                        isActive 
                          ? "bg-white shadow-lg transform scale-105" 
                          : "opacity-80 hover:opacity-100 hover:bg-white/40"
                      )}
                      initial={{ opacity: 0, y: 10 }}
                      animate={{ opacity: 1, y: 0 }}
                      transition={{ delay: index * 0.04 }}
                      whileTap={{ scale: 0.95 }}
                    >
                      <div className={cn(
                        "relative w-14 h-14 sm:w-12 sm:h-12 md:w-14 md:h-14 rounded-full overflow-hidden transition-all duration-500",
                        isActive 
                          ? "ring-2 ring-offset-2 shadow-2xl rotate-0" 
                          : "shadow-md group-hover:shadow-xl group-hover:rotate-6"
                      )}
                      style={isActive ? {
                        boxShadow: `0 0 0 2px white, 0 0 0 4px ${flavor.accent}, 0 20px 25px -5px rgba(0, 0, 0, 0.1)`
                      } : {}}>
                        <Image
                          src={encodeURI(flavor.donutImg)}
                          alt={flavor.name}
                          width={64}
                          height={64}
                          className={cn(
                            "object-cover transition-transform duration-500",
                            !isActive && "group-hover:scale-110"
                          )}
                        />
                      </div>
                      <span className={cn(
                        "mt-2 text-xs sm:text-xs font-semibold transition-all duration-300 text-center px-1",
                        isActive 
                          ? "text-gray-900 text-sm" 
                          : "text-gray-600 group-hover:text-gray-900"
                      )}>
                        {flavor.name.split(' ')[0]}
                      </span>
                    </motion.button>
                  )
                })}
                  </div>
                </div>
                
                <motion.button
                  onClick={() => navigateFlavor('next')}
                  className="hidden lg:flex flex-shrink-0 ml-2 w-8 h-8 items-center justify-center rounded-full bg-white/90 backdrop-blur-sm shadow-md hover:shadow-lg transition-all"
                  aria-label="Next flavor"
                  whileHover={{ scale: 1.1 }}
                  whileTap={{ scale: 0.9 }}
                >
                  <svg className="w-4 h-4 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2.5} d="M9 5l7 7-7 7" />
                  </svg>
                </motion.button>
              </div>
            </div>
          </motion.div>

          {/* Visual Content */}
          <div className="relative w-full h-[350px] sm:h-[400px] md:h-[450px] lg:h-[500px] order-1 lg:order-2">
            <motion.div
              className="relative w-full h-full flex items-center justify-center"
              style={{
                x: donutX,
                y: donutY,
              }}
            >
              <AnimatePresence mode="popLayout">
                {/* Main Donut */}
                <motion.div
                  key={activeFlavor.id}
                  initial={{ opacity: 0, scale: 0.6, rotate: -180 }}
                  animate={{ opacity: 1, scale: 1, rotate: 0 }}
                  exit={{ opacity: 0, scale: 0.6, rotate: 180 }}
                  transition={{ 
                    duration: 0.8, 
                    ease: [0.25, 0.46, 0.45, 0.94],
                        <motion.div 
                          className="absolute inset-0 rounded-2xl opacity-30"
                          style={{ 
                            background: `radial-gradient(circle, ${flavor.accent} 0%, transparent 70%)`,
                            filter: 'blur(10px)'
                          }}
                          animate={{ scale: [1, 1.2, 1] }}
                          transition={{ duration: 2, repeat: Infinity }}
                        />
                      )}
                      
                      <div className={cn(
                        "relative w-14 h-14 sm:w-12 sm:h-12 md:w-14 md:h-14 rounded-full overflow-hidden transition-all duration-500",
                        isActive 
                          ? "ring-2 ring-offset-2 shadow-2xl rotate-0" 
                          : "shadow-md group-hover:shadow-xl group-hover:rotate-6"
                      )}
                      style={isActive ? {
                        boxShadow: `0 0 0 2px white, 0 0 0 4px ${flavor.accent}, 0 20px 25px -5px rgba(0, 0, 0, 0.1)`
                      } : {}}>
                        <Image
                          src={encodeURI(flavor.donutImg)}
                          alt={flavor.name}
                          width={64}
                          height={64}
                          className={cn(
                            "object-cover transition-transform duration-500",
                            !isActive && "group-hover:scale-110"
                          )}
                        />
                        {/* Shine effect on hover */}
                        <div className="absolute inset-0 bg-gradient-to-tr from-transparent via-white/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 -translate-x-full group-hover:translate-x-full" style={{ transition: 'transform 0.6s' }} />
                      </div>
                      
                      <span className={cn(
                        "mt-2 text-xs sm:text-xs font-semibold transition-all duration-300 text-center px-1",
                        isActive 
                          ? "text-gray-900 text-sm" 
                          : "text-gray-600 group-hover:text-gray-900"
                      )}>
                        {flavor.name.split(' ')[0]}
                      </span>
                      
                      {/* Sparkle emoji for active */}
                      {isActive && (
                        <motion.span 
                          className="absolute -top-1 -right-1 text-base"
                          initial={{ scale: 0, rotate: -180 }}
                          animate={{ scale: 1, rotate: 0 }}
                          exit={{ scale: 0, rotate: 180 }}
                        >
                          ✨
                        </motion.span>
                      )}
                      
                      {/* Bottom indicator */}
                      {isActive && (
                        <motion.div 
                          className="absolute -bottom-2 left-1/2 transform -translate-x-1/2 w-8 h-1 rounded-full"
                          style={{ backgroundColor: flavor.accent }}
                          layoutId="activeIndicator"
                          transition={{ type: "spring", stiffness: 300, damping: 30 }}
                        />
                      )}
                    </motion.button>
                  )
                })}
                    <motion.button
                      key={`clone-end-${flavor.id}`}
                      onClick={() => {
                        onFlavorChange(flavor)
                        setIsAutoPlaying(false)
                      }}
                      className={cn(
                        "group relative flex flex-col items-center p-2 sm:p-1.5 rounded-xl transition-all duration-300 min-w-[80px] sm:min-w-[68px] flex-shrink-0",
                        isActive 
                          ? "bg-white shadow-lg transform scale-105" 
                          : "opacity-80 hover:opacity-100 hover:bg-white/40"
                      )}
                      initial={{ opacity: 0, y: 10 }}
                      animate={{ opacity: 1, y: 0 }}
                      transition={{ delay: index * 0.04 }}
                      whileTap={{ scale: 0.95 }}
                    >
                      <div className={cn(
                        "relative w-14 h-14 sm:w-12 sm:h-12 md:w-14 md:h-14 rounded-full overflow-hidden transition-all duration-500",
                        isActive 
                          ? "ring-2 ring-offset-2 shadow-2xl rotate-0" 
                          : "shadow-md group-hover:shadow-xl group-hover:rotate-6"
                      )}
                      style={isActive ? {
                        boxShadow: `0 0 0 2px white, 0 0 0 4px ${flavor.accent}, 0 20px 25px -5px rgba(0, 0, 0, 0.1)`
                      } : {}}>
                        <Image
                          src={encodeURI(flavor.donutImg)}
                          alt={flavor.name}
                          width={64}
                          height={64}
                          className={cn(
                            "object-cover transition-transform duration-500",
                            !isActive && "group-hover:scale-110"
                          )}
                        />
                      </div>
                      <span className={cn(
                        "mt-2 text-xs sm:text-xs font-semibold transition-all duration-300 text-center px-1",
                        isActive 
                          ? "text-gray-900 text-sm" 
                          : "text-gray-600 group-hover:text-gray-900"
                      )}>
                        {flavor.name.split(' ')[0]}
                      </span>
                    </motion.button>
                  )
                })} */}
                  </div>
                </div>
                
                <motion.button
                  onClick={() => navigateFlavor('next')}
                  className="hidden lg:flex flex-shrink-0 ml-2 w-8 h-8 items-center justify-center rounded-full bg-white/90 backdrop-blur-sm shadow-md hover:shadow-lg transition-all"
                  aria-label="Next flavor"
                  whileHover={{ scale: 1.1 }}
                  whileTap={{ scale: 0.9 }}
                >
                  <svg className="w-4 h-4 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2.5} d="M9 5l7 7-7 7" />
                  </svg>
                </motion.button>
              </div>
            </div>
          </motion.div>

          {/* Visual Content */}
          <div className="relative w-full h-[350px] sm:h-[400px] md:h-[450px] lg:h-[500px] order-1 lg:order-2">
            <motion.div
              className="relative w-full h-full flex items-center justify-center"
              style={{
                x: donutX,
                y: donutY,
              }}
            >
              <AnimatePresence mode="popLayout">
                {/* Main Donut */}
                <motion.div
                  key={activeFlavor.id}
                  initial={{ opacity: 0, scale: 0.6, rotate: -180 }}
                  animate={{ opacity: 1, scale: 1, rotate: 0 }}
                  exit={{ opacity: 0, scale: 0.6, rotate: 180 }}
                  transition={{ 
                    duration: 0.8, 
                    ease: [0.25, 0.46, 0.45, 0.94],
                  }}
                  className="relative w-full h-full flex items-center justify-center"
                >
                  <motion.div
                    className="relative w-[280px] h-[280px] sm:w-[320px] sm:h-[320px] md:w-[380px] md:h-[380px] lg:w-[440px] lg:h-[440px] max-w-[90vw] max-h-[90vw]"
                    animate={{
                      y: [0, -10, 0],
                      rotateZ: [0, 2, -2, 0],
                    }}
                    transition={{
                      duration: 6,
                      repeat: Infinity,
                      ease: 'easeInOut',
                    }}
                  >
                    <Image
                      src={encodeURI(activeFlavor.donutImg)}
                      alt={activeFlavor.name}
                      fill
                      className="object-contain"
                      priority
                      quality={95}
                      sizes="(max-width: 640px) 80vw, (max-width: 1024px) 50vw, 40vw"
                      style={{
                        filter: 'drop-shadow(0 10px 20px rgba(0,0,0,0.08))',
                        transform: 'translateZ(0)',
                      }}
                    />
                    <div className="light-sweep" />
                  </motion.div>
                </motion.div>

                {/* Prop 1 */}
                <motion.div
                  key={activeFlavor.id + '-prop1'}
                  initial={{ opacity: 0, scale: 0.8 }}
                  animate={{ opacity: 1, scale: 1 }}
                  exit={{ opacity: 0, scale: 0.8 }}
                  transition={{ duration: 0.6, delay: 0.1 }}
                  className="absolute top-[10%] left-[8%] w-14 h-14 sm:w-18 sm:h-18 lg:w-20 lg:h-20"
                  style={{
                    x: prop1X,
                    y: prop1Y,
                  }}
                >
                  <motion.div
                    className="relative w-full h-full"
                    animate={{
                      rotate: [0, 10, -10, 0],
                      y: [0, -3, 3, 0],
                    }}
                    transition={{
                      duration: 8,
                      repeat: Infinity,
                      ease: 'easeInOut',
                    }}
                  >
                    <Image
                      src={encodeURI(activeFlavor.props[0])}
                      alt=""
                      fill
                      className="object-contain drop-shadow-xl"
                      quality={90}
                      sizes="144px"
                    />
                  </motion.div>
                </motion.div>

                {/* Prop 2 */}
                <motion.div
                  key={activeFlavor.id + '-prop2'}
                  initial={{ opacity: 0, scale: 0.8 }}
                  animate={{ opacity: 1, scale: 1 }}
                  exit={{ opacity: 0, scale: 0.8 }}
                  transition={{ duration: 0.6, delay: 0.2 }}
                  className="absolute bottom-[18%] right-[8%] w-16 h-16 sm:w-20 sm:h-20 lg:w-24 lg:h-24"
                  style={{
                    x: prop2X,
                    y: prop2Y,
                  }}
                >
                  <motion.div
                    className="relative w-full h-full"
                    animate={{
                      rotate: [0, -12, 12, 0],
                      y: [0, 3, -3, 0],
                    }}
                    transition={{
                      duration: 7,
                      repeat: Infinity,
                      ease: 'easeInOut',
                    }}
                  >
                    <Image
                      src={encodeURI(activeFlavor.props[1])}
                      alt=""
                      fill
                      className="object-contain drop-shadow-xl"
                      quality={90}
                      sizes="128px"
                    />
                  </motion.div>
                </motion.div>
              </AnimatePresence>
            </motion.div>
          </div>
          </div>
        </div>
      </div>
    </section>
  )
}